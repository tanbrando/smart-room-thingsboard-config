        "tbelScript" : "var temp = parseFloat(msg.temperature);\nvar threshold = parseFloat(metadata.shared_temperatureThreshold);\n\n// Nếu nhiệt độ > ngưỡng -> Nhánh True (Bật Alarm)\nif (temp > threshold) {\n    return true;\n}\n// Nếu nhiệt độ hạ xuống dưới ngưỡng 1 độ -> Nhánh False (Xóa Alarm)\nif (temp < (threshold - 1.0)) {\n    return false;\n}\n// Ở khoảng giữa 29 và 30 thì bỏ qua không đổi trạng thái"
